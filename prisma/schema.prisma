generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexão via pooler (usada pelo app)
  directUrl = env("DIRECT_URL") // conexão direta (usada nas migrações)
}

// Cada barbearia cliente do sistema. Todos os outros dados pertencem a uma barbearia.
model Barbearia {
  id                String  @id @default(cuid())
  nome              String
  slug              String  @unique // usado na página pública: /b/<slug>
  telefone          String?
  endereco          String?
  instagram         String?
  descricao         String?
  logo              String? // imagem (data URL) redimensionada no navegador
  capa              String?
  corDestaque       String  @default("#c9a14a")
  intervaloMin      Int     @default(30) // de quanto em quanto tempo os horários são oferecidos
  antecedenciaDias  Int     @default(30) // até quantos dias à frente o cliente pode agendar
  cancelamentoHoras Int     @default(2) // até quantas horas antes o cliente pode cancelar pelo link
  cashbackPct       Int     @default(0) // % do valor pago que volta como crédito para o cliente

  // Textos das mensagens de WhatsApp (vazio = texto padrão)
  msgConfirmacao String?
  msgLembrete    String?

  // Assinatura do KlarezaBarber (o que a barbearia paga para usar o sistema)
  plano    String  @default("BAIRRO") // BAIRRO | CIDADE | NACIONAL
  ciclo    String  @default("MENSAL") // MENSAL | ANUAL
  pagoAte  String? // "2026-11-10"; vazio = sem vencimento controlado
  suspensa Boolean @default(false) // sem pagamento: painel e agendamento bloqueados

  // Asaas: subconta de recebimento da barbearia (dinheiro dos clientes)
  asaasContaId           String?
  asaasWalletId          String?
  asaasApiKey            String? // criptografada
  asaasStatus            String? // PENDING | AWAITING_APPROVAL | APPROVED | REJECTED
  cobrancaOnlineClube    Boolean  @default(false)
  // Asaas: cobrança do plano do KlarezaBarber (conta principal)
  asaasClienteSistemaId  String?
  asaasAssinaturaSistema String?  @unique
  linkPagamentoSistema   String?
  criadoEm               DateTime @default(now())

  usuarios          Usuario[]
  filiais           Filial[]
  barbeiros         Barbeiro[]
  servicos          Servico[]
  clientes          Cliente[]
  agendamentos      Agendamento[]
  bloqueios         Bloqueio[]
  produtos          Produto[]
  comandas          Comanda[]
  caixas            Caixa[]
  planos            Plano[]
  assinaturas       Assinatura[]
  contas            ContaPagar[]
  banners           Banner[]
  pagamentosSistema PagamentoSistema[]
  parceiros         Parceiro[]
}

// Unidade (filial) da barbearia: endereço, expediente, equipe, agenda e caixa próprios.
// Clientes, serviços, planos, banners e parceiros são compartilhados por todas as unidades.
model Filial {
  id          String    @id @default(cuid())
  barbeariaId String
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  nome        String
  endereco    String?
  telefone    String?
  ativo       Boolean   @default(true)
  ordem       Int       @default(0)
  criadoEm    DateTime  @default(now())

  horarios     HorarioFuncionamento[]
  barbeiros    Barbeiro[]
  agendamentos Agendamento[]
  comandas     Comanda[]
  caixas       Caixa[]
  bloqueios    Bloqueio[]
  estoques     EstoqueFilial[]
  movimentos   MovimentoEstoque[]

  @@index([barbeariaId])
}

model HorarioFuncionamento {
  id        String @id @default(cuid())
  filialId  String
  filial    Filial @relation(fields: [filialId], references: [id], onDelete: Cascade)
  diaSemana Int // 0 = domingo ... 6 = sábado
  abre      String // "09:00"
  fecha     String // "19:00"

  @@unique([filialId, diaSemana])
}

// Login do painel administrativo.
model Usuario {
  id          String    @id @default(cuid())
  barbeariaId String
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  nome        String
  email       String    @unique
  senhaHash   String
  papel       String    @default("DONO") // DONO | GERENTE | BARBEIRO
  barbeiroId  String?   @unique // login do próprio barbeiro (vê só a agenda e comissões dele)
  barbeiro    Barbeiro? @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  criadoEm    DateTime  @default(now())
}

model Barbeiro {
  id                 String    @id @default(cuid())
  barbeariaId        String
  barbearia          Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  filialId           String
  filial             Filial    @relation(fields: [filialId], references: [id], onDelete: NoAction)
  nome               String
  telefone           String?
  foto               String?
  comissaoPct        Int       @default(50) // comissão padrão nos serviços
  comissaoProdutoPct Int       @default(10) // comissão nas vendas de produtos
  destaque           Boolean   @default(false) // selo "Destaque" na página do cliente
  bio                String?
  ativo              Boolean   @default(true)
  criadoEm           DateTime  @default(now())

  servicos     Servico[] // serviços que ele faz (vazio = todos)
  agendamentos Agendamento[]
  bloqueios    Bloqueio[]
  comandas     Comanda[]
  itens        ComandaItem[]
  usuario      Usuario?
}

model Servico {
  id            String    @id @default(cuid())
  barbeariaId   String
  barbearia     Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  nome          String
  categoria     String    @default("Cabelo")
  descricao     String?
  foto          String?
  precoCentavos Int
  duracaoMin    Int
  comissaoPct   Int? // se preenchido, substitui a comissão padrão do barbeiro
  exibirOnline  Boolean   @default(true)
  ativo         Boolean   @default(true)
  ordem         Int       @default(0)
  criadoEm      DateTime  @default(now())

  barbeiros    Barbeiro[]
  agendamentos Agendamento[]
  planos       Plano[]
  itens        ComandaItem[]
}

model Cliente {
  id                    String    @id @default(cuid())
  barbeariaId           String
  barbearia             Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  nome                  String
  telefone              String // só dígitos
  email                 String?
  nascimento            String? // "1990-05-21"
  observacao            String?
  saldoCashbackCentavos Int       @default(0)
  senhaHash             String? // acesso à área do cliente
  cpf                   String? // exigido para pagar online
  asaasClienteId        String?
  criadoEm              DateTime  @default(now())

  agendamentos Agendamento[]
  comandas     Comanda[]
  assinaturas  Assinatura[]

  @@unique([barbeariaId, telefone])
}

model Agendamento {
  id                   String    @id @default(cuid())
  barbeariaId          String
  barbearia            Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  filialId             String
  filial               Filial    @relation(fields: [filialId], references: [id], onDelete: NoAction)
  barbeiroId           String
  barbeiro             Barbeiro  @relation(fields: [barbeiroId], references: [id])
  servicoId            String
  servico              Servico   @relation(fields: [servicoId], references: [id])
  clienteId            String
  cliente              Cliente   @relation(fields: [clienteId], references: [id])
  inicio               DateTime
  fim                  DateTime
  precoCentavos        Int // preço no momento do agendamento
  status               String    @default("AGENDADO") // AGENDADO | CONFIRMADO | CONCLUIDO | CANCELADO | FALTOU
  origem               String    @default("ONLINE") // ONLINE | PAINEL
  formaPagamento       String?
  observacao           String?
  token                String    @unique @default(cuid()) // link para o cliente ver/cancelar
  grupo                String? // agendamentos de vários serviços em sequência compartilham o grupo
  confirmacaoEnviadaEm DateTime?
  lembreteEnviadoEm    DateTime?
  criadoEm             DateTime  @default(now())

  comanda Comanda?

  @@index([barbeariaId, inicio])
  @@index([barbeiroId, inicio])
  @@index([grupo])
}

// Folgas, almoço, férias: horários em que não se pode agendar.
model Bloqueio {
  id          String    @id @default(cuid())
  barbeariaId String
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeiroId  String? // vazio = a unidade inteira (ou todas, se filialId também estiver vazio)
  barbeiro    Barbeiro? @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  filialId    String?
  filial      Filial?   @relation(fields: [filialId], references: [id], onDelete: Cascade)
  inicio      DateTime
  fim         DateTime
  motivo      String?
  criadoEm    DateTime  @default(now())

  @@index([barbeariaId, inicio])
}

model Produto {
  id            String    @id @default(cuid())
  barbeariaId   String
  barbearia     Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  nome          String
  categoria     String    @default("Geral")
  precoCentavos Int
  custoCentavos Int       @default(0)
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now())

  estoques   EstoqueFilial[]
  movimentos MovimentoEstoque[]
  itens      ComandaItem[]
}

// Quantidade de cada produto em cada unidade.
model EstoqueFilial {
  id         String  @id @default(cuid())
  produtoId  String
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  filialId   String
  filial     Filial  @relation(fields: [filialId], references: [id], onDelete: Cascade)
  quantidade Int     @default(0)
  minimo     Int     @default(0) // avisa quando chegar nesse número

  @@unique([produtoId, filialId])
}

model MovimentoEstoque {
  id         String   @id @default(cuid())
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  filialId   String
  filial     Filial   @relation(fields: [filialId], references: [id], onDelete: Cascade)
  quantidade Int // positivo = entrada, negativo = saída
  tipo       String // ENTRADA | VENDA | AJUSTE | ESTORNO | TRANSFERENCIA
  observacao String?
  criadoEm   DateTime @default(now())
}

// Conta do atendimento: serviços + produtos, desconto e forma de pagamento.
model Comanda {
  id                     String       @id @default(cuid())
  numero                 Int          @default(autoincrement())
  barbeariaId            String
  barbearia              Barbearia    @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  filialId               String
  filial                 Filial       @relation(fields: [filialId], references: [id], onDelete: NoAction)
  clienteId              String?
  cliente                Cliente?     @relation(fields: [clienteId], references: [id])
  barbeiroId             String?
  barbeiro               Barbeiro?    @relation(fields: [barbeiroId], references: [id])
  agendamentoId          String?      @unique
  agendamento            Agendamento? @relation(fields: [agendamentoId], references: [id])
  caixaId                String?
  caixa                  Caixa?       @relation(fields: [caixaId], references: [id])
  status                 String       @default("ABERTA") // ABERTA | FECHADA | CANCELADA
  descontoCentavos       Int          @default(0)
  cashbackUsadoCentavos  Int          @default(0)
  cashbackGeradoCentavos Int          @default(0)
  totalCentavos          Int          @default(0) // valor efetivamente pago
  formaPagamento         String?
  abertaEm               DateTime     @default(now())
  fechadaEm              DateTime?

  itens ComandaItem[]

  @@index([barbeariaId, fechadaEm])
}

model ComandaItem {
  id                String    @id @default(cuid())
  comandaId         String
  comanda           Comanda   @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  tipo              String // SERVICO | PRODUTO
  servicoId         String?
  servico           Servico?  @relation(fields: [servicoId], references: [id])
  produtoId         String?
  produto           Produto?  @relation(fields: [produtoId], references: [id])
  barbeiroId        String?
  barbeiro          Barbeiro? @relation(fields: [barbeiroId], references: [id])
  descricao         String
  quantidade        Int       @default(1)
  precoUnitCentavos Int
  comissaoPct       Int       @default(0)
  cobertoPorPlano   Boolean   @default(false) // serviço incluso na assinatura do cliente (não cobra)
}

model Caixa {
  id                      String    @id @default(cuid())
  barbeariaId             String
  barbearia               Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  filialId                String
  filial                  Filial    @relation(fields: [filialId], references: [id], onDelete: NoAction)
  abertoEm                DateTime  @default(now())
  fechadoEm               DateTime?
  saldoInicialCentavos    Int       @default(0)
  dinheiroContadoCentavos Int? // valor em dinheiro contado no fechamento
  observacao              String?

  movimentos MovimentoCaixa[]
  comandas   Comanda[]
  pagamentos PagamentoAssinatura[]
}

model MovimentoCaixa {
  id            String   @id @default(cuid())
  caixaId       String
  caixa         Caixa    @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  tipo          String // SUPRIMENTO | SANGRIA | DESPESA
  valorCentavos Int
  descricao     String
  criadoEm      DateTime @default(now())
}

// Clube de assinatura (ex.: corte ilimitado por R$ 99/mês).
model Plano {
  id            String    @id @default(cuid())
  barbeariaId   String
  barbearia     Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  nome          String
  descricao     String?
  precoCentavos Int
  usosPorMes    Int? // vazio = ilimitado
  exibirOnline  Boolean   @default(true)
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now())

  servicos    Servico[] // serviços incluídos
  assinaturas Assinatura[]
}

model Assinatura {
  id            String    @id @default(cuid())
  barbeariaId   String
  barbearia     Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  clienteId     String
  cliente       Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  planoId       String
  plano         Plano     @relation(fields: [planoId], references: [id])
  status        String    @default("ATIVA") // ATIVA | CANCELADA
  inicio        DateTime  @default(now())
  pagoAte       String // "2026-11-09": cobertura vale até esse dia
  asaasId       String?   @unique // assinatura recorrente no Asaas
  linkPagamento String? // link da cobrança em aberto mais recente
  criadoEm      DateTime  @default(now())

  pagamentos PagamentoAssinatura[]
}

model PagamentoAssinatura {
  id                   String     @id @default(cuid())
  assinaturaId         String
  assinatura           Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  caixaId              String?
  caixa                Caixa?     @relation(fields: [caixaId], references: [id])
  valorCentavos        Int
  formaPagamento       String
  pagoEm               DateTime   @default(now())
  asaasPagamentoId     String?    @unique
  valorLiquidoCentavos Int? // o que sobra depois da taxa do Asaas
}

// Despesas da barbearia (aluguel, luz, fornecedores, comissões pagas...).
model ContaPagar {
  id             String    @id @default(cuid())
  barbeariaId    String
  barbearia      Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  descricao      String
  categoria      String    @default("Outros")
  valorCentavos  Int
  vencimento     String // "2026-10-15"
  pagoEm         DateTime?
  formaPagamento String?
  criadoEm       DateTime  @default(now())

  @@index([barbeariaId, vencimento])
}

// Banners da área do cliente (promoções, avisos, parceiros).
model Banner {
  id          String    @id @default(cuid())
  barbeariaId String
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  imagem      String
  link        String?
  ordem       Int       @default(0)
  criadoEm    DateTime  @default(now())
}

// Clube de vantagens: parceiros com cupons de desconto para os clientes.
model Parceiro {
  id          String    @id @default(cuid())
  barbeariaId String
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  nome        String
  descricao   String?
  cupom       String?
  imagem      String?
  link        String?
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now())
}

// Pagamentos que a barbearia fez ao KlarezaBarber.
model PagamentoSistema {
  id               String    @id @default(cuid())
  barbeariaId      String
  barbearia        Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  plano            String
  ciclo            String
  valorCentavos    Int
  referenteAte     String // até quando esse pagamento cobre
  observacao       String?
  pagoEm           DateTime  @default(now())
  asaasPagamentoId String?   @unique

  @@index([barbeariaId, pagoEm])
}

// Configurações gerais do KlarezaBarber (uma linha só, id = "geral").
model ConfigSistema {
  id                String  @id @default("geral")
  whatsappSuporte   String? // número para as barbearias pedirem suporte ou mudança de plano
  taxaPlataformaPct Int     @default(0) // % de cada pagamento online que vai para o KlarezaBarber (split)
  asaasWalletId     String? // carteira da conta principal (destino do split)
}
